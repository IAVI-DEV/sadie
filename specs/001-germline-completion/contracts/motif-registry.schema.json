{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sadie.org/schemas/motif-registry.schema.json",
  "title": "MOTIF_LOOKUP Registry Schema",
  "description": "JSON Schema for J-gene FWR4 motif patterns with provenance metadata",
  "type": "object",
  "patternProperties": {
    "^[a-z0-9_]+$": {
      "type": "object",
      "properties": {
        "_provenance": {
          "$ref": "#/$defs/motif-provenance"
        },
        "ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of gene names to ignore during motif validation"
        }
      },
      "patternProperties": {
        "^(IGH|IGK|IGL|TRA|TRB|TRD|TRG)[JV]$": {
          "type": "string",
          "pattern": "^[A-Z\\[\\]\\{\\}\\.\\*\\+\\?\\|\\(\\)\\-\\\\]+$",
          "description": "Regex pattern for motif matching"
        }
      },
      "additionalProperties": false,
      "required": ["_provenance"]
    }
  },
  "additionalProperties": false,
  "minProperties": 1,
  "$defs": {
    "motif-provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Literature or database source for the motif patterns"
        },
        "imgt_validated": {
          "type": "boolean",
          "description": "Whether patterns are derived from canonical IMGT motifs"
        },
        "last_reviewed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO date (YYYY-MM-DD) of last review"
        },
        "notes": {
          "type": "string",
          "description": "Historical context, limitations, or additional information"
        },
        "validation_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of sequences validated against these patterns"
        },
        "validation_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Match percentage (0.0-1.0) in validation testing"
        }
      },
      "required": ["source", "imgt_validated", "last_reviewed"],
      "additionalProperties": false
    }
  }
}